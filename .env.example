RAPIDAPI_KEY=your_rapidapi_key_here
# SQLite on one PC: sqlite:///./crest_forensic.db   |   company server: postgresql://crest_app:PASSWORD@db-host:5432/crest  (see DEPLOY_POSTGRES.md)
DATABASE_URL=sqlite:///./crest_forensic.db
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# set to 1 when the app is served over HTTPS through a reverse proxy (marks the sign-in cookie Secure)
CREST_COOKIE_SECURE=
